{
  "name": "Aurea Quantra Pulse",
  "dataColors": [
    "#D4AF37",
    "#5B8DEF",
    "#5C7A6B",
    "#C9A227",
    "#8B7355",
    "#4A6FA5",
    "#E8B84A",
    "#E8DCC8"
  ],
  "background": "#0D1117",
  "foreground": "#FFF8E7",
  "foregroundNeutralSecondary": "#D9C89A",
  "foregroundNeutralTertiary": "#9A8B6F",
  "tableAccent": "#D4AF37",
  "good": "#5C7A6B",
  "neutral": "#8B7355",
  "bad": "#C75B5B",
  "maximum": "#D4AF37",
  "center": "#3D5A80",
  "minimum": "#1A1F26",
  "textClasses": {
    "callout": {
      "fontSize": 36,
      "fontFace": "Segoe UI Semibold",
      "color": "#D4AF37"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#D4AF37"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#FFF8E7"
    },
    "label": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#D9C89A"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0D1117" } },
            "transparency": 0
          }
        ],
        "wallpaper": [{ "show": false }]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#1A1F26" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D4AF37" } },
            "radius": 10,
            "width": 1
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#D4AF37" } },
            "fontSize": 12,
            "bold": true
          }
        ],
        "labels": [{ "color": { "solid": { "color": "#FFF8E7" } } }],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "transparency": 70,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#D9C89A" } }, "fontSize": 11 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#D4AF37" } } }]
      }
    },
    "cardVisual": {
      "*": {
        "accentBar": [{ "show": true, "color": { "solid": { "color": "#D4AF37" } }, "width": 4 }],
        "value": [{ "fontSize": 28, "color": { "solid": { "color": "#FFF8E7" } } }],
        "label": [{ "color": { "solid": { "color": "#D4AF37" } }, "fontSize": 11 }]
      }
    },
    "slicer": {
      "*": {
        "data": [{ "mode": "Dropdown" }],
        "selection": [
          {
            "singleSelect": false,
            "selectAllCheckboxEnabled": true,
            "strictSingleSelect": false
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#D4AF37" } },
            "fontSize": 11,
            "bold": true
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#FFF8E7" } },
            "background": { "solid": { "color": "#1A1F26" } },
            "textSize": 10
          }
        ],
        "general": [
          {
            "outlineColor": { "solid": { "color": "#D4AF37" } },
            "selfFilterEnabled": true
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#D9C89A" } },
            "titleColor": { "solid": { "color": "#D4AF37" } }
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#D9C89A" } },
            "gridlineColor": { "solid": { "color": "#2A3140" } }
          }
        ],
        "labels": [{ "color": { "solid": { "color": "#FFF8E7" } } }],
        "dataPoint": [{ "fill": { "solid": { "color": "#D4AF37" } } }]
      }
    },
    "multiRowCard": {
      "*": {
        "categoryLabels": [{ "color": { "solid": { "color": "#D4AF37" } } }],
        "dataLabels": [{ "color": { "solid": { "color": "#FFF8E7" } } }],
        "cardTitle": [{ "color": { "solid": { "color": "#D4AF37" } } }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }]
      }
    }
  }
}
