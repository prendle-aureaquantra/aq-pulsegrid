# AQ PulseGrid — copy to .env (repo root or aq-pulsegrid/) for local pipeline + deploy scripts.

# Data layout (optional)
# PULSEGRID_DATA_ROOT=~/.local/aq-pulsegrid

# --- Transit GTFS-RT (optional; unlock metros missing from MobilityData catalog) ---
# Washington DC — WMATA bus/rail alerts (header api_key)
# Register: https://developer.wmata.com/
# WMATA_API_KEY=

# Houston METRO — appends subscription-key to api.ridemetro.org URLs
# Register: https://api-portal.ridemetro.org/
# HOUSTON_METRO_API_KEY=
# HOUSTON_METRO_GTFS_RT_ALERTS_URL=https://api.ridemetro.org/v2alertspb/alerts.pb

# Dallas DART — set full alerts URL from https://dart.developer.azure-api.net/ when available
# DART_GTFS_RT_ALERTS_URL=
# DART_API_KEY=

# --- LLM Copilot (Lightsail status app) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Fabric / Power BI embed (Lightsail) ---
# FABRIC_TENANT_ID=
# FABRIC_CLIENT_ID=
# FABRIC_CLIENT_SECRET=
# POWERBI_PULSEGRID_WORKSPACE_ID=
# POWERBI_PULSEGRID_REPORT_ID=
# POWERBI_PULSEGRID_EMBED_URL=
# PULSEGRID_PUBLIC_URL=https://pulse.aureaquantra.com/

# --- Macro / extended ingest (optional) ---
# FRED_API_KEY=
