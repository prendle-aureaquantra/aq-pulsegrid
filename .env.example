# AQ PulseGrid — copy to .env (never commit .env)

# Optional HTTP User-Agent for public APIs
PULSEGRID_USER_AGENT=AQ-PulseGrid/0.1 (your-org; contact@example.com)

# Delta + PBIP output root (default: ~/.local/aq-pulsegrid)
# PULSEGRID_DATA_ROOT=C:\data\pulsegrid

# FRED economic series (free key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Google Trends (optional; pip install pytrends)
# No API key — rate-limited by Google

# Alerting (optional)
PULSEGRID_SLACK_WEBHOOK_URL=
PULSEGRID_ALERT_EMAIL_TO=

# Databricks (optional — for tools/run_databricks_pipeline.py)
DATABRICKS_HOST=https://dbc-xxxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_CONFIG_PROFILE=aureaquantra
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_REPO_PATH=/Repos/pulsegrid/aq-pulsegrid

# GitHub — Aurea Quantra org account (https://github.com/prendle-aureaquantra)
# Fine-grained or classic PAT with repo + workflow scopes for push/CI to org repos.
# Public repo: https://github.com/prendle-aureaquantra/aq-pulsegrid
AUREAQUANTRA_GITHUB_TOKEN=
GITHUB_ORG=prendle-aureaquantra
PULSEGRID_REPO=https://github.com/prendle-aureaquantra/aq-pulsegrid

# AI copilot (python -m pulsegrid.copilot.insights chicago)
OPENAI_API_KEY=

# Fabric embed for WordPress /pulsegrid/ page (tools/sync_pulsegrid_site_page.py)
POWERBI_PULSEGRID_EMBED_URL=

# Lightsail operational status app (deploy/lightsail — uses parent repo SSH_* via tools/deploy_pulsegrid_lightsail.py)
# PULSEGRID_PUBLIC_URL=http://YOUR_LIGHTSAIL_IP:5190/
